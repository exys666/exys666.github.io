---
layout: base.hbs
page_title: exys666.com - posts
---
<header>
    {{> navbar }}
</header>
<main>
    <h1>Posts</h1>
    <ul id="posts">
        {{#each collections.postReversed}}
        <li><a href="{{ this.url }}">
            <time datetime="{{dateToISO date }}"><span>{{dateGetYear date }}</span><span>{{dateGetMonth date }}</span><span>{{dateGetDay date }}</span></time>
            <h2>{{ this.data.title }}</h2>
            <p>{{ this.data.description }}</p>
        </a></li>
        {{/each}}
    </ul>
</main>
